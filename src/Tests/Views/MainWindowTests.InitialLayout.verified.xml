<MainWindow
  ThemeMode="None"
  Title="Meridian"
  Width="1024"
  Height="768"
  xmlns="clr-namespace:Meridian.Views;assembly=Meridian"
  xmlns:av="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:mvm="clr-namespace:Meridian.ViewModels;assembly=Meridian"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="clr-namespace:Meridian.Converters;assembly=Meridian">
  <MainWindow.InputBindings>
    <av:KeyBinding
      Gesture="Ctrl+T"
      Modifiers="Ctrl"
      Key="T">
      <av:KeyBinding.Command>
        <mvm:RelayCommand />
      </av:KeyBinding.Command>
    </av:KeyBinding>
    <av:KeyBinding
      Gesture="Ctrl+W"
      Modifiers="Ctrl"
      Key="W">
      <av:KeyBinding.Command>
        <mvm:RelayCommand />
      </av:KeyBinding.Command>
    </av:KeyBinding>
    <av:KeyBinding
      Gesture="Alt+Left"
      Modifiers="Alt"
      Key="Left">
      <av:KeyBinding.Command>
        <mvm:RelayCommand />
      </av:KeyBinding.Command>
    </av:KeyBinding>
    <av:KeyBinding
      Gesture="Alt+Right"
      Modifiers="Alt"
      Key="Right">
      <av:KeyBinding.Command>
        <mvm:RelayCommand />
      </av:KeyBinding.Command>
    </av:KeyBinding>
    <av:KeyBinding
      Gesture="Alt+Up"
      Modifiers="Alt"
      Key="Up">
      <av:KeyBinding.Command>
        <mvm:RelayCommand />
      </av:KeyBinding.Command>
    </av:KeyBinding>
  </MainWindow.InputBindings>
  <av:DockPanel>
    <av:ToolBar
      av:DockPanel.Dock="Top"
      av:ToolBarTray.IsLocked="True">
      <av:Button
        Padding="8,2,8,2"
        Style="{av:DynamicResource {x:Static av:ToolBar.ButtonStyleKey}}"
        ToolTip="Back (Alt+Left)">
        <av:Button.Command>
          <mvm:RelayCommand />
        </av:Button.Command>←</av:Button>
      <av:Button
        Padding="8,2,8,2"
        Style="{av:DynamicResource {x:Static av:ToolBar.ButtonStyleKey}}"
        ToolTip="Forward (Alt+Right)">
        <av:Button.Command>
          <mvm:RelayCommand />
        </av:Button.Command>→</av:Button>
      <av:Button
        Padding="8,2,8,2"
        Style="{av:DynamicResource {x:Static av:ToolBar.ButtonStyleKey}}"
        ToolTip="Up (Alt+Up)">
        <av:Button.Command>
          <mvm:RelayCommand />
        </av:Button.Command>↑</av:Button>
      <av:Separator
        Style="{av:DynamicResource {x:Static av:ToolBar.SeparatorStyleKey}}" />
      <AddressBar
        Name="AddressBar"
        Width="500">
        <av:TextBox
          VerticalContentAlignment="Center"
          Name="PathBox">{UserProfile}</av:TextBox>
      </AddressBar>
      <av:Separator
        Style="{av:DynamicResource {x:Static av:ToolBar.SeparatorStyleKey}}" />
      <av:Button
        Padding="8,2,8,2"
        Style="{av:DynamicResource {x:Static av:ToolBar.ButtonStyleKey}}"
        ToolTip="New Tab (Ctrl+T)">
        <av:Button.Command>
          <mvm:RelayCommand />
        </av:Button.Command>+</av:Button>
    </av:ToolBar>
    <av:StatusBar
      av:DockPanel.Dock="Bottom">
      <av:StatusBarItem>
        <av:TextBlock
          Text="71 items" />
      </av:StatusBarItem>
    </av:StatusBar>
    <av:TabControl>
      <av:TabControl.ContentTemplate>
        <av:DataTemplate
          DataType="{x:Type mvm:TabViewModel}">
          <FileBrowserTab>
            <FileBrowserTab.Resources>
              <av:HierarchicalDataTemplate
                ItemsSource="{av:Binding Path=Children}"
                ItemTemplate="{x:Null}"
                ItemTemplateSelector="{x:Null}"
                ItemContainerStyle="{x:Null}"
                ItemContainerStyleSelector="{x:Null}"
                ItemStringFormat="{x:Null}"
                AlternationCount="0"
                ItemBindingGroup="{x:Null}"
                DataType="{x:Type mvm:FolderNode}"
                x:Key="{av:DataTemplateKey DataType={x:Type mvm:FolderNode}}">
                <av:StackPanel
                  Orientation="Horizontal">
                  <av:Image
                    Source="{x:Null}"
                    Width="16"
                    Height="16"
                    Margin="0,0,4,0" />
                  <av:TextBlock
                    Text="" />
                </av:StackPanel>
              </av:HierarchicalDataTemplate>
              <mc:FileSizeConverter
                x:Key="FileSizeConverter" />
            </FileBrowserTab.Resources>
            <av:Grid>
              <av:Grid.ColumnDefinitions>
                <av:ColumnDefinition
                  Width="250" />
                <av:ColumnDefinition
                  Width="5" />
                <av:ColumnDefinition
                  Width="*" />
              </av:Grid.ColumnDefinitions>
              <av:TreeView
                av:VirtualizingPanel.IsVirtualizing="True"
                av:VirtualizingPanel.VirtualizationMode="Recycling"
                av:Grid.Column="0" />
              <av:GridSplitter
                Background="#FFCCCCCC"
                HorizontalAlignment="Stretch"
                av:Grid.Column="1" />
              <av:ListView
                Name="FileList"
                AllowDrop="True"
                av:VirtualizingPanel.IsVirtualizing="True"
                av:VirtualizingPanel.VirtualizationMode="Recycling"
                av:Grid.Column="2">
                <av:ListView.View>
                  <av:GridView>
                    <av:GridViewColumn
                      DisplayMemberBinding="{x:Null}"
                      Width="300">
                      <av:GridViewColumn.CellTemplate>
                        <av:DataTemplate>
                          <av:StackPanel
                            Orientation="Horizontal">
                            <av:Image
                              Source="{x:Null}"
                              Width="16"
                              Height="16"
                              Margin="0,0,4,0" />
                            <av:TextBlock
                              Text="" />
                          </av:StackPanel>
                        </av:DataTemplate>
                      </av:GridViewColumn.CellTemplate>Name</av:GridViewColumn>
                    <av:GridViewColumn
                      DisplayMemberBinding="{av:Binding Path=DateModified, StringFormat=\{0:yyyy-MM-dd HH:mm\}}"
                      Width="150">Date Modified</av:GridViewColumn>
                    <av:GridViewColumn
                      DisplayMemberBinding="{av:Binding Path=Extension}"
                      Width="100">Type</av:GridViewColumn>
                    <av:GridViewColumn
                      Width="100">
                      <av:GridViewColumn.DisplayMemberBinding>
                        <av:Binding
                          Path="Size">
                          <av:Binding.Converter>
                            <mc:FileSizeConverter />
                          </av:Binding.Converter>
                        </av:Binding>
                      </av:GridViewColumn.DisplayMemberBinding>Size</av:GridViewColumn>
                  </av:GridView>
                </av:ListView.View>
                <av:ListView.ContextMenu>
                  <av:ContextMenu>
                    <av:MenuItem
                      Command="{x:Null}"
                      InputGestureText="Ctrl+X"
                      Header="Cut" />
                    <av:MenuItem
                      Command="{x:Null}"
                      InputGestureText="Ctrl+C"
                      Header="Copy" />
                    <av:MenuItem
                      Command="{x:Null}"
                      InputGestureText="Ctrl+V"
                      Header="Paste" />
                    <av:Separator />
                    <av:MenuItem
                      Command="{x:Null}"
                      InputGestureText="Del"
                      Header="Delete" />
                    <av:MenuItem
                      Command="{x:Null}"
                      InputGestureText="F2"
                      Header="Rename" />
                    <av:Separator />
                    <av:MenuItem
                      Command="{x:Null}"
                      Header="New Folder" />
                  </av:ContextMenu>
                </av:ListView.ContextMenu>
              </av:ListView>
            </av:Grid>
          </FileBrowserTab>
        </av:DataTemplate>
      </av:TabControl.ContentTemplate>
      <av:TabControl.ItemTemplate>
        <av:DataTemplate
          DataType="{x:Type mvm:TabViewModel}">
          <av:StackPanel
            Orientation="Horizontal">
            <av:TextBlock
              Text=""
              Margin="0,0,8,0" />
            <av:Button
              Command="{x:Null}"
              BorderThickness="0,0,0,0"
              Background="#00FFFFFF"
              FontSize="10"
              Padding="2,0,2,0"
              VerticalAlignment="Center"
              Cursor="Hand">×</av:Button>
          </av:StackPanel>
        </av:DataTemplate>
      </av:TabControl.ItemTemplate>
      <mvm:TabViewModel />
    </av:TabControl>
  </av:DockPanel>
</MainWindow>