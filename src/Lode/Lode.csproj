<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
    net11.0 rather than net11.0-windows, with the Windows Forms framework referenced directly. The
    SDK refuses to pack a tool for a platform specific target framework (NETSDK1146), and
    UseWindowsForms insists on one.
    -->
    <TargetFramework>net11.0</TargetFramework>
    <ToolCommandName>lode</ToolCommandName>
    <PackAsTool>True</PackAsTool>
    <Description>Alternative to Windows File Explorer.</Description>
    <PackageTags>file-manager;explorer;windows;winforms;dotnet-tool</PackageTags>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RollForward>LatestMajor</RollForward>
    <!-- LibraryImport generates unsafe marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Long path support. Copied into the apphost, and the tool shim dotnet tool install makes. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <InternalsVisibleTo Include="Lode.Tests" />
    <InternalsVisibleTo Include="Lode.Benchmarks" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
    <PackageReference Include="PackageUpdateLib" />
    <PackageReference Include="LibGit2Sharp" />
  </ItemGroup>
  <!--
  Lode runs only on Windows, so libgit2 built for Linux and macOS, nine of the twelve builds
  LibGit2Sharp brings, is left out of the output, the tool's deps.json and its package: 16 MB of
  the 22 MB.
  -->
  <Target Name="WindowsLibGit2Only" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <RuntimeTargetsCopyLocalItems
        Remove="@(RuntimeTargetsCopyLocalItems)"
        Condition="'%(RuntimeTargetsCopyLocalItems.NuGetPackageId)' == 'LibGit2Sharp.NativeBinaries' and !$([System.String]::Copy('%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)').StartsWith('win-'))" />
    </ItemGroup>
  </Target>
</Project>
