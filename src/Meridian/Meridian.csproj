<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
    net11.0 rather than net11.0-windows, with the Windows Forms framework referenced directly. The
    SDK refuses to pack a tool for a platform specific target framework (NETSDK1146), and
    UseWindowsForms insists on one.
    -->
    <TargetFramework>net11.0</TargetFramework>
    <ToolCommandName>meridian</ToolCommandName>
    <AssemblyName>Meridian</AssemblyName>
    <!-- "Meridian" on nuget.org is an unrelated package. -->
    <PackageId>MeridianFileManager</PackageId>
    <PackAsTool>True</PackAsTool>
    <Description>Alternative to Windows File Explorer.</Description>
    <PackageTags>file-manager;explorer;windows;winforms;dotnet-tool</PackageTags>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <InternalsVisibleTo Include="Meridian.Tests" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
  </ItemGroup>
</Project>
