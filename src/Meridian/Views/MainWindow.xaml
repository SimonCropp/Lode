<Window x:Class="Meridian.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Meridian.Views"
        xmlns:viewModels="clr-namespace:Meridian.ViewModels"
        Title="Meridian"
        Width="1024"
        Height="768">
  <Window.InputBindings>
    <KeyBinding Key="T"
                Modifiers="Ctrl"
                Command="{Binding NewTabCommand}" />
    <KeyBinding Key="W"
                Modifiers="Ctrl"
                Command="{Binding ActiveTab.CloseCommand}" />
    <KeyBinding Key="Left"
                Modifiers="Alt"
                Command="{Binding BackCommand}" />
    <KeyBinding Key="Right"
                Modifiers="Alt"
                Command="{Binding ForwardCommand}" />
    <KeyBinding Key="Up"
                Modifiers="Alt"
                Command="{Binding UpCommand}" />
  </Window.InputBindings>

  <DockPanel>
    <ToolBar DockPanel.Dock="Top"
             ToolBarTray.IsLocked="True">
      <Button Content="&#x2190;"
              ToolTip="Back (Alt+Left)"
              Command="{Binding BackCommand}"
              Padding="8,2" />
      <Button Content="&#x2192;"
              ToolTip="Forward (Alt+Right)"
              Command="{Binding ForwardCommand}"
              Padding="8,2" />
      <Button Content="&#x2191;"
              ToolTip="Up (Alt+Up)"
              Command="{Binding UpCommand}"
              Padding="8,2" />
      <Separator />
      <views:AddressBar x:Name="AddressBar"
                         Width="500"
                         DataContext="{Binding}" />
      <Separator />
      <Button Content="+"
              ToolTip="New Tab (Ctrl+T)"
              Command="{Binding NewTabCommand}"
              Padding="8,2" />
    </ToolBar>

    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem>
        <TextBlock Text="{Binding StatusText}" />
      </StatusBarItem>
    </StatusBar>

    <TabControl ItemsSource="{Binding Tabs}"
                SelectedItem="{Binding ActiveTab}">
      <TabControl.ItemTemplate>
        <DataTemplate DataType="{x:Type viewModels:TabViewModel}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding DirectoryName}"
                       Margin="0,0,8,0" />
            <Button Content="&#x00D7;"
                    Command="{Binding CloseCommand}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="2,0"
                    FontSize="10"
                    VerticalAlignment="Center"
                    Cursor="Hand" />
          </StackPanel>
        </DataTemplate>
      </TabControl.ItemTemplate>
      <TabControl.ContentTemplate>
        <DataTemplate DataType="{x:Type viewModels:TabViewModel}">
          <views:FileBrowserTab />
        </DataTemplate>
      </TabControl.ContentTemplate>
    </TabControl>
  </DockPanel>
</Window>
