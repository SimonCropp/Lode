<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>Exe</OutputType>
    <NoWarn>$(NoWarn);CA1416;WFO1000</NoWarn>
    <!-- The app's manifest, so long path tests run with the long path support Lode has. -->
    <ApplicationManifest>../Lode/app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="Verify" />
    <PackageReference Include="Verify.TUnit" />
    <PackageReference Include="Verify.WinForms" />
    <ProjectReference Include="..\Lode\Lode.csproj" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
  </ItemGroup>
</Project>
