<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <!-- Local builds only. CI builds a tag as the version it names. -->
    <Version>0.1.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Verify_SponsorshipExemption>OpenSource</Verify_SponsorshipExemption>
    <Verify_SponsorshipExemptionUntil>2027-08</Verify_SponsorshipExemptionUntil>
    <SignAssembly>false</SignAssembly>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.Threading.CancellationToken"
           Alias="Cancel" />
    <Using Include="System.Threading.CancellationTokenSource"
           Alias="CancelSource" />
    <Using Include="System.ReadOnlySpan&lt;System.Char&gt;"
           Alias="CharSpan" />
  </ItemGroup>
</Project>
